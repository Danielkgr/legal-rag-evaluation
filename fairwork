#!/usr/bin/env bash
# Launcher for a clone that has not been installed with pip.  It puts src/ on
# PYTHONPATH and runs the interactive menu.  Run it from the project root so
# the menu's default folders (data/raw, data/processed) resolve.
#   ./fairwork
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m legal_rag.cli "$@"
